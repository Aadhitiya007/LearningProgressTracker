# Example environment configuration for Learning Progress Tracker
# Copy this file to .env and fill in your values (leave blank to skip optional integrations)

ONEDRIVE_FOLDER=
REPORT_NAME=Learning_Progress_Report

# Power Automate Webhook (optional)
POWER_AUTOMATE_URL=
MANAGER_EMAIL=
MANAGER_NAME=

# Snowflake Settings (optional)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=TRACKER_WH
SNOWFLAKE_DATABASE=LEARNING_TRACKER
SNOWFLAKE_SCHEMA=CERTIFICATION_DATA
SNOWFLAKE_TABLE=EMPLOYEE_CERTIFICATIONS

# Business Rules
PASSING_SCORE=50
OVERDUE_WARN_DAYS=7
